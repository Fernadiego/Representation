@page "/proveedores"
@inject CommerceService Commerce
@inject TenantState TenantState
@implements IDisposable

<PageTitle>Proveedores</PageTitle>

<h1 class="mb-4">Proveedores</h1>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="mb-0">@(_editingSupplier.Id == 0 ? "Nuevo proveedor" : $"Editar #{_editingSupplier.Id}")</h5>
            </div>
            <div class="card-body">
                <EditForm Model="_editingSupplier" OnValidSubmit="SaveSupplier">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <InputText class="form-control" @bind-Value="_editingSupplier.Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Contacto</label>
                        <InputText class="form-control" @bind-Value="_editingSupplier.ContactName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Teléfono</label>
                        <InputText class="form-control" @bind-Value="_editingSupplier.Phone" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Correo</label>
                        <InputText class="form-control" @bind-Value="_editingSupplier.Email" />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Guardar</button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="ResetForm">Cancelar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Listado</h5>
                <span class="badge text-bg-secondary">@_suppliers.Count proveedores</span>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Contacto</th>
                            <th>Teléfono</th>
                            <th>Correo</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!_suppliers.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">Sin proveedores registrados</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var supplier in _suppliers)
                            {
                                <tr>
                                    <td>@supplier.Name</td>
                                    <td>@supplier.ContactName</td>
                                    <td>@supplier.Phone</td>
                                    <td>@supplier.Email</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-link" @onclick="() => EditSupplier(supplier)">Editar</button>
                                        <button class="btn btn-sm btn-link text-danger" @onclick="() => DeleteSupplier(supplier.Id)">Eliminar</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Supplier> _suppliers = new();
    private Supplier _editingSupplier = new();

    protected override async Task OnInitializedAsync()
    {
        TenantState.OnTenantChanged += HandleTenantChanged;
        await LoadSuppliers(resetForm: true);
    }

    public void Dispose()
    {
        TenantState.OnTenantChanged -= HandleTenantChanged;
    }

    private async Task LoadSuppliers(bool resetForm = false)
    {
        var companyId = TenantState.CurrentCompanyId;
        if (companyId is null)
        {
            _suppliers.Clear();
            if (resetForm)
            {
                ResetForm();
            }
            return;
        }

        _suppliers = await Commerce.GetSuppliersAsync(companyId.Value);
        if (resetForm)
        {
            ResetForm();
        }
    }

    private void ResetForm()
    {
        _editingSupplier = new Supplier
        {
            CompanyId = TenantState.CurrentCompanyId ?? 0
        };
    }

    private void EditSupplier(Supplier supplier)
    {
        _editingSupplier = new Supplier
        {
            Id = supplier.Id,
            CompanyId = supplier.CompanyId,
            Name = supplier.Name,
            ContactName = supplier.ContactName,
            Phone = supplier.Phone,
            Email = supplier.Email
        };
    }

    private async Task SaveSupplier()
    {
        if (TenantState.CurrentCompanyId is not int companyId)
        {
            return;
        }

        await Commerce.SaveSupplierAsync(companyId, _editingSupplier);
        await LoadSuppliers(resetForm: true);
    }

    private async Task DeleteSupplier(int id)
    {
        if (TenantState.CurrentCompanyId is not int companyId)
        {
            return;
        }

        await Commerce.DeleteSupplierAsync(companyId, id);
        await LoadSuppliers(resetForm: true);
    }

    private async void HandleTenantChanged(Company _)
    {
        await InvokeAsync(async () =>
        {
            await LoadSuppliers(resetForm: true);
            StateHasChanged();
        });
    }
}

