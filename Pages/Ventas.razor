    }
    
    private void FilterClientes()
    {
        if (string.IsNullOrWhiteSpace(_clienteSearchText))
        {
            _filteredClientes = _customers.Take(10).ToList();
        }
        else
        {
            var searchLower = _clienteSearchText.ToLower().Trim();
            var searchTerms = searchLower.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
            
            _filteredClientes = _customers
                .Where(c => 
                {
                    // Buscar por ID exacto o parcial
                    if (int.TryParse(searchLower, out int codigoBuscado))
                    {
                        if (c.Id == codigoBuscado || c.Id.ToString().Contains(searchLower))
                            return true;
                    }
                    
                    // Buscar por ID parcial
                    if (c.Id.ToString().Contains(searchLower))
                        return true;
                    
                    // Buscar por nombre completo
                    var nombreLower = c.Name.ToLower();
                    if (nombreLower.Contains(searchLower))
                        return true;
                    
                    // Buscar por términos individuales (descripción parcial)
                    if (searchTerms.Length > 0)
                    {
                        return searchTerms.All(term => nombreLower.Contains(term));
                    }
                    
                    return false;
                })
                .OrderBy(c => 
                {
                    // Priorizar coincidencias exactas de ID
                    if (int.TryParse(searchLower, out int codigo) && c.Id == codigo)
                        return 0;
                    // Luego coincidencias que empiezan con el texto
                    if (c.Name.ToLower().StartsWith(searchLower))
                        return 1;
                    // Finalmente otras coincidencias
                    return 2;
                })
                .Take(20)
                .ToList();
        }
    }
    
