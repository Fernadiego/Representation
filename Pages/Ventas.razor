    private string NumeroALetras(decimal numero)
    {
        var entero = (long)Math.Floor(numero);
        var centavos = (int)Math.Round((numero - entero) * 100);
        
        string[] unidades = { "", "un", "dos", "tres", "cuatro", "cinco", "seis", "siete", "ocho", "nueve" };
        string[] especiales = { "diez", "once", "doce", "trece", "catorce", "quince", "dieciséis", "diecisiete", "dieciocho", "diecinueve" };
        string[] decenas = { "", "", "veinte", "treinta", "cuarenta", "cincuenta", "sesenta", "setenta", "ochenta", "noventa" };
        string[] centenas = { "", "ciento", "doscientos", "trescientos", "cuatrocientos", "quinientos", "seiscientos", "setecientos", "ochocientos", "novecientos" };
        
        string ConvertirGrupo(int n)
        {
            if (n == 0) return "";
            if (n == 100) return "cien";
            
            var resultado = "";
            var c = n / 100;
            var resto = n % 100;
            
            if (c > 0) resultado = centenas[c] + " ";
            
            if (resto >= 10 && resto <= 19)
            {
                resultado += especiales[resto - 10];
            }
            else
            {
                var d = resto / 10;
                var u = resto % 10;
                
                if (d > 0)
                {
                    resultado += decenas[d];
                    if (u > 0)
                    {
                        resultado += d == 2 ? "i" : " y ";
                        resultado += unidades[u];
                    }
                }
                else if (u > 0)
                {
                    resultado += unidades[u];
                }
            }
            
            return resultado.Trim();
        }
        
        if (entero == 0) return "cero pesos con " + centavos.ToString("D2") + "/100";
        
        var miles = (int)(entero / 1000);
        var unidad = (int)(entero % 1000);
        
        var texto = "";
        if (miles > 0)
        {
            texto = miles == 1 ? "mil " : ConvertirGrupo(miles) + " mil ";
        }
        texto += ConvertirGrupo(unidad);
        
        return texto.Trim() + " pesos con " + centavos.ToString("D2") + "/100";
    }

    private void ClearGrid()
    {
        // Limpiar todas las líneas nuevas de la grilla
        for (int i = 0; i < _newLines.Count; i++)
        {
            var line = _newLines[i];
            
            // Si la línea también está en la venta actual, removerla de ahí
            if (_saleDraft.Lines.Contains(line))
            {
                _saleDraft.Lines.Remove(line);
            }
            
            // Limpiar estados de edición relacionados
            var lineKey = $"new_{i}";
            if (_lineEditStates.ContainsKey(lineKey))
            {
                _lineEditStates.Remove(lineKey);
            }
            var editStateKey = $"edit_{lineKey}";
            if (_gridEditStates.ContainsKey(editStateKey))
            {
                _gridEditStates.Remove(editStateKey);
            }
        }
        
        _newLines.Clear();
        _expandedLines.Clear();
        _currentPage = 1; // Resetear a la primera página
        StateHasChanged();
    }

