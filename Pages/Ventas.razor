        }
    }

    private void AutocompletarArticulo(GridLineEditState editState, SaleLine line, string lineKey)
    {
        if (string.IsNullOrWhiteSpace(editState.ArticuloSearch))
            return;

        Product? product = null;
        
        // Si el formato es "ID - Nombre" del datalist, extraer solo el ID
        var searchText = editState.ArticuloSearch;
        if (searchText.Contains(" - "))
        {
            var parts = searchText.Split(" - ");
            if (parts.Length > 0 && int.TryParse(parts[0].Trim(), out var idFromDatalist))
            {
                product = _products.FirstOrDefault(p => p.Id == idFromDatalist);
            }
        }
        
        // Si no se encontró, intentar buscar solo por ID numérico
        if (product == null && int.TryParse(searchText.Trim(), out var productId))
        {
            product = _products.FirstOrDefault(p => p.Id == productId);
        }
        
        // Si aún no se encontró, buscar por nombre exacto
        if (product == null)
        {
            product = _products.FirstOrDefault(p => p.Name.Equals(searchText.Trim(), StringComparison.OrdinalIgnoreCase));
        }

        if (product != null)
        {
            // Actualizar todos los campos de la línea
            editState.ProductId = product.Id;
            line.ProductId = product.Id;
            line.UnitPrice = product.UnitPrice;
            editState.UnitPrice = product.UnitPrice;
            editState.ArticuloSearch = product.Id.ToString();
            
            // Siempre establecer cantidad en 1 cuando se selecciona un artículo
            line.Quantity = 1;
            editState.Quantity = 1;
            
            // Actualizar la navegación del producto para que la descripción se muestre
            line.Product = product;
            
            // Si es una línea nueva, agregarla también a la venta actual
            if (lineKey.StartsWith("new_") && !_saleDraft.Lines.Contains(line))
            {
                _saleDraft.Lines.Add(line);
            }
            
            // Actualizar el estado de edición de la línea expandida
            var lineEditState = GetLineEditState(lineKey, line);
            if (lineEditState != null)
            {
                // Determinar lista inicial basada en el precio
                var precio = product.UnitPrice;
                var tolerance = 0.01m;
                
                if (Math.Abs(precio - product.PrecioLista1) < tolerance || 
                    (product.PrecioLista1 == 0 && Math.Abs(precio - product.UnitPrice) < tolerance))
                {
                    lineEditState.ListaSeleccionada = 1;
                }
                else if (Math.Abs(precio - product.PrecioLista2) < tolerance)
                {
                    lineEditState.ListaSeleccionada = 2;
                }
                else if (Math.Abs(precio - product.PrecioLista3) < tolerance)
                {
                    lineEditState.ListaSeleccionada = 3;
                }
                else if (Math.Abs(precio - product.PrecioLista4) < tolerance)
                {
                    lineEditState.ListaSeleccionada = 4;
                }
            }
            
            StateHasChanged();
            
            // Enfocar y seleccionar el campo de cantidad después del render
            _ = InvokeAsync(async () =>
            {
                await FocusQuantityField(lineKey);
            });
        }
    }

