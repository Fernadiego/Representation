            Quantity = 1,
            UnitPrice = defaultProduct?.UnitPrice ?? 0
        });
    }

    private async Task OpenAddArticleModal()
    {
        // Agregar una nueva línea vacía a la grilla
        _newLines.Add(new SaleLine
        {
            ProductId = 0,
            Quantity = 1,
            UnitPrice = 0
        });
        
        // Ir a la última página para mostrar la línea recién agregada
        var newTotalPages = (int)Math.Ceiling((double)_newLines.Count / _pageSize);
        if (newTotalPages > 0)
        {
            _currentPage = newTotalPages;
        }
        
        StateHasChanged();
        
        // Enfocar el campo de artículo del nuevo row después del render
        await InvokeAsync(async () =>
        {
            await FocusArticuloField($"new_{_newLines.Count - 1}");
        });
    }

    private void RemoveNewLine(SaleLine line)
    {
        _newLines.Remove(line);
        // Si la línea también está en la venta actual, removerla de ahí
        if (_saleDraft.Lines.Contains(line))
        {
            _saleDraft.Lines.Remove(line);
        }
        StateHasChanged();
    }

    private void RemoveLine(SaleLine line)
    {
        if (_saleDraft.Lines.Count <= 1)
        {
            return;
        }

        _saleDraft.Lines.Remove(line);
    }

