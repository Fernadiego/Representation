    private string GetProductImageUrl(Product? product)
    {
        if (product == null)
        {
            return "/favicon.png";
        }

        try
        {
            return ImageService.GetProductImagePath(product.ImagePath, product.Id);
        }
        catch
        {
            // Si hay error, usar favicon como fallback
            return "/favicon.png";
        }
    }
