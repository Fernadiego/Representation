    private LineEditState GetLineEditState(string lineKey, SaleLine line)
    {
        if (!_lineEditStates.ContainsKey(lineKey))
        {
            var state = new LineEditState();
            // Determinar lista inicial basada en el precio
            if (line.Product != null)
            {
                var precio = line.UnitPrice;
                var tolerance = 0.01m;
                
                if (Math.Abs(precio - line.Product.PrecioLista1) < tolerance || 
                    (line.Product.PrecioLista1 == 0 && Math.Abs(precio - line.Product.UnitPrice) < tolerance))
                {
                    state.ListaSeleccionada = 1;
                }
                else if (Math.Abs(precio - line.Product.PrecioLista2) < tolerance)
                {
                    state.ListaSeleccionada = 2;
                }
                else if (Math.Abs(precio - line.Product.PrecioLista3) < tolerance)
                {
                    state.ListaSeleccionada = 3;
                }
                else if (Math.Abs(precio - line.Product.PrecioLista4) < tolerance)
                {
                    state.ListaSeleccionada = 4;
                }
                else
                {
                    state.ListaSeleccionada = 1; // Por defecto
                }
            }
            _lineEditStates[lineKey] = state;
        }
        return _lineEditStates[lineKey];
    }

    private void OnListaChanged(ChangeEventArgs e, SaleLine line, LineEditState state)
    {
        if (int.TryParse(e.Value?.ToString(), out var lista))
        {
            state.ListaSeleccionada = lista;
            if (line.Product != null)
            {
                // Actualizar precio según la lista seleccionada
                line.UnitPrice = lista switch
                {
                    1 => line.Product.PrecioLista1 > 0 ? line.Product.PrecioLista1 : line.Product.UnitPrice,
                    2 => line.Product.PrecioLista2 > 0 ? line.Product.PrecioLista2 : line.Product.UnitPrice,
                    3 => line.Product.PrecioLista3 > 0 ? line.Product.PrecioLista3 : line.Product.UnitPrice,
                    4 => line.Product.PrecioLista4 > 0 ? line.Product.PrecioLista4 : line.Product.UnitPrice,
                    _ => line.Product.UnitPrice
                };
            }
            StateHasChanged();
        }
    }

    private void OnIVAChanged(ChangeEventArgs e, SaleLine line, LineEditState state)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var iva))
        {
            state.IVASeleccionado = iva;
            if (iva != -1)
            {
                state.NuevoIVA = 0;
            }
            StateHasChanged();
        }
    }

    private void AgregarNuevoIVA(LineEditState state)
    {
        if (state.NuevoIVA > 0 && !_ivasDisponibles.Contains(state.NuevoIVA))
        {
            _ivasDisponibles.Add(state.NuevoIVA);
            _ivasDisponibles.Sort();
            state.IVASeleccionado = state.NuevoIVA;
            state.NuevoIVA = 0;
            StateHasChanged();
        }
    }

    private void CancelarNuevoIVA(LineEditState state)
    {
        state.IVASeleccionado = 21m; // Volver al IVA por defecto
        state.NuevoIVA = 0;
        StateHasChanged();
    }

    private decimal CalculateIVA(SaleLine line, LineEditState state)
    {
        var ivaRate = state.IVASeleccionado == -1 ? 0m : state.IVASeleccionado / 100m;
        return line.UnitPrice * ivaRate;
    }

    private List<Product> GetFilteredProducts(string searchText)
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            return _products.Take(10).ToList();
        }

        var searchLower = searchText.ToLowerInvariant();
        var results = new List<Product>();

        // Buscar por ID numérico
        if (int.TryParse(searchText, out var productId))
        {
            var exactMatch = _products.FirstOrDefault(p => p.Id == productId);
            if (exactMatch != null)
            {
                results.Add(exactMatch);
            }
        }

        // Buscar por ID que contenga el texto
        var idMatches = _products.Where(p => p.Id.ToString().Contains(searchText)).Take(5).ToList();
        foreach (var match in idMatches)
        {
            if (!results.Contains(match))
            {
                results.Add(match);
            }
        }

        // Buscar por nombre o SKU
        var nameMatches = _products.Where(p => 
            p.Name.ToLowerInvariant().Contains(searchLower) || 
            p.Sku.ToLowerInvariant().Contains(searchLower)).Take(5).ToList();
        
        foreach (var match in nameMatches)
        {
            if (!results.Contains(match))
            {
                results.Add(match);
            }
        }

        return results.Take(10).ToList();
    }

