        });
    }

    private void OnTipoComprobanteChanged(ChangeEventArgs e)
    {
        _autoGenerandoNumero = true; // Marcar que estamos auto-generando
        
        // Limpiar el error de comprobante cuando se cambia el tipo
        _comprobanteError = null;
        
        _saleDraft.TipoComprobante = e.Value?.ToString() ?? string.Empty;
        
        if (e.Value?.ToString() == "NPV")
        {
            // Auto-generar número NPV
            var ultimoNPV = _sales
                .Where(s => s.TipoComprobante == "NPV" && !string.IsNullOrEmpty(s.NumeroComprobante))
                .Select(s => int.TryParse(s.NumeroComprobante, out var num) ? num : 0)
                .DefaultIfEmpty(0)
                .Max();
            _saleDraft.NumeroComprobante = (ultimoNPV + 1).ToString();
        }
        else if (e.Value?.ToString() == "Factura")
        {
            // Auto-generar número Factura
            var ultimoFactura = _sales
                .Where(s => s.TipoComprobante == "Factura" && !string.IsNullOrEmpty(s.NumeroComprobante))
                .Select(s => int.TryParse(s.NumeroComprobante, out var num) ? num : 0)
                .DefaultIfEmpty(0)
                .Max();
            _saleDraft.NumeroComprobante = (ultimoFactura + 1).ToString();
        }
        else
        {
            // Limpiar número si no hay tipo seleccionado
            _saleDraft.NumeroComprobante = string.Empty;
        }
        
        _autoGenerandoNumero = false; // Ya no estamos auto-generando
        StateHasChanged(); // Forzar actualización del UI para que la clase has-value se actualice
        StateHasChanged();
        
        // NO buscar automáticamente cuando se auto-genera, solo cuando el usuario ingrese manualmente
    }

    private async Task OnNumeroComprobanteKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_autoGenerandoNumero)
        {
            // Limpiar el error de comprobante cuando se ingresa un número
            _comprobanteError = null;
            
            // Si el campo número está vacío, limpiar la grilla
            if (string.IsNullOrWhiteSpace(_saleDraft.NumeroComprobante) || string.IsNullOrWhiteSpace(_saleDraft.TipoComprobante))
            {
                ClearGrid();
            }
            // Si hay tipo y número, buscar el comprobante existente
            else if (!string.IsNullOrWhiteSpace(_saleDraft.TipoComprobante) && !string.IsNullOrWhiteSpace(_saleDraft.NumeroComprobante))
            {
                await LoadSaleByComprobante();
            }
        }
    }

    private async Task LoadSaleByComprobante()
    {
        if (TenantState.CurrentCompanyId is not int companyId)
            return;

        if (string.IsNullOrWhiteSpace(_saleDraft.TipoComprobante) || string.IsNullOrWhiteSpace(_saleDraft.NumeroComprobante))
            return;

        try
        {
            var existingSale = await Commerce.GetSaleByComprobanteAsync(companyId, _saleDraft.TipoComprobante, _saleDraft.NumeroComprobante);
            
            if (existingSale != null)
            {
                // Cargar los datos de la venta en el draft
                _saleDraft.Date = existingSale.Date;
                _saleDraft.CustomerId = existingSale.CustomerId;
                _saleDraft.VendorId = existingSale.VendorId;
                _saleDraft.SucursalId = existingSale.SucursalId;
                _saleDraft.Vencimiento = existingSale.Vencimiento;
                _saleDraft.ComprobOriginado = existingSale.ComprobOriginado;
                _saleDraft.RemitoAsociado = existingSale.RemitoAsociado;
                _saleDraft.Estado = existingSale.Estado;

                // Limpiar líneas nuevas y estados de edición
                _newLines.Clear();
                _lineEditStates.Clear();
                _gridEditStates.Clear();
                _expandedLines.Clear();
                _currentPage = 1; // Resetear a la primera página

                // Cargar las líneas de la venta existente en _newLines para que aparezcan en la grilla
                foreach (var line in existingSale.Lines)
                {
                    var product = _products.FirstOrDefault(p => p.Id == line.ProductId);
                    _newLines.Add(new SaleLine
                    {
                        ProductId = line.ProductId,
                        Quantity = line.Quantity,
                        UnitPrice = line.UnitPrice,
                        Product = product
                    });
                }

                // También agregarlas al draft
                _saleDraft.Lines.Clear();
                
                // Actualizar texto de búsqueda de cliente y vendedor
                UpdateClienteSearchText();
                UpdateVendedorSearchText();
                foreach (var line in existingSale.Lines)
                {
                    var product = _products.FirstOrDefault(p => p.Id == line.ProductId);
                    _saleDraft.Lines.Add(new SaleLine
                    {
                        ProductId = line.ProductId,
                        Quantity = line.Quantity,
                        UnitPrice = line.UnitPrice,
                        Product = product
                    });
                }

                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            _error = $"Error al cargar la venta: {ex.Message}";
            StateHasChanged();
        }
    }

