    private async Task OnQuantityKeyDown(KeyboardEventArgs e, GridLineEditState editState, SaleLine line, string lineKey)
    {
        if (e.Key == "Enter" || e.Key == "NumpadEnter")
        {
            // Leer el valor actual del input usando una expresión directa
            var quantityInputId = $"quantity_{lineKey}";
            string? currentQuantityValue = null;
            try
            {
                // Usar una expresión que devuelva directamente el valor
                currentQuantityValue = await JSRuntime.InvokeAsync<string>("eval", 
                    $"(document.getElementById('{quantityInputId}') || {{value: ''}}).value");
            }
            catch
            {
                // Si falla, usar el valor del estado
                currentQuantityValue = editState.Quantity > 0 ? editState.Quantity.ToString() : null;
            }
            
            // Verificar que la cantidad tenga un valor distinto de null/vacío (puede ser cualquier número válido)
            bool shouldAddRow = false;
            int quantityToUse = 0;
            
            if (!string.IsNullOrWhiteSpace(currentQuantityValue) && int.TryParse(currentQuantityValue, out quantityToUse))
            {
                shouldAddRow = true;
            }
            // Si el input está vacío pero hay un valor válido en el estado, también agregar row
            else if (editState.Quantity > 0 || line.Quantity > 0)
            {
                quantityToUse = editState.Quantity > 0 ? editState.Quantity : line.Quantity;
                shouldAddRow = true;
            }
            
            if (shouldAddRow)
            {
                // Actualizar la cantidad en ambos lugares
                editState.Quantity = quantityToUse;
                line.Quantity = quantityToUse;
                
                // Agregar un nuevo row y enfocar el campo artículo
                await AddNewRowAndFocusArticulo();
            }
        }
    }

    private async Task AddNewRowAndFocusArticulo()
    {
        // Agregar una nueva línea vacía a la grilla
        _newLines.Add(new SaleLine
        {
            ProductId = 0,
            Quantity = 1,
            UnitPrice = 0
        });
        
        // Ir a la última página para mostrar la línea recién agregada
        var newTotalPages = (int)Math.Ceiling((double)_newLines.Count / _pageSize);
        if (newTotalPages > 0)
        {
            _currentPage = newTotalPages;
        }
        
        StateHasChanged();
        
        // Enfocar el campo de artículo del nuevo row después del render
        await InvokeAsync(async () =>
        {
            await FocusArticuloField($"new_{_newLines.Count - 1}");
        });
    }

    private async Task FocusQuantityField(string lineKey)
    {
        await Task.Delay(50); // Esperar un poco para que se renderice
        var elementId = $"quantity_{lineKey}";
        await JSRuntime.InvokeVoidAsync("eval", 
            $"var input = document.getElementById('{elementId}'); " +
            "if (input) { input.focus(); input.select(); }");
    }

    private async Task FocusArticuloField(string lineKey)
    {
        await Task.Delay(100); // Esperar un poco más para que se renderice el nuevo row
        var elementId = $"articulo_{lineKey}";
        await JSRuntime.InvokeVoidAsync("eval", 
            $"var input = document.getElementById('{elementId}'); " +
            "if (input) { input.focus(); input.select(); }");
    }

    private decimal GetTotalVenta()
    {
        decimal total = 0;
        
        // Calcular total de líneas nuevas (incluyen todas las líneas en edición)
        foreach (var line in _newLines)
        {
            var lineKey = $"new_{_newLines.IndexOf(line)}";
            var lineEditState = GetLineEditState(lineKey, line);
            var ivaRate = lineEditState.IVASeleccionado == -1 ? 0m : lineEditState.IVASeleccionado / 100m;
            total += line.LineTotal + (line.UnitPrice * ivaRate * line.Quantity);
        }
        
        // Calcular total de líneas de la venta actual que no están en líneas nuevas
        foreach (var line in _saleDraft.Lines)
        {
            if (!_newLines.Contains(line))
            {
                // Usar IVA por defecto si no hay estado de edición
                var ivaRate = 21m / 100m; // IVA por defecto 21%
                total += line.LineTotal + (line.UnitPrice * ivaRate * line.Quantity);
            }
        }
        
        return total;
    }

    private async Task SaveSaleFromGrid()
    {
        // Limpiar el error de comprobante
        _comprobanteError = null;
        
        // Validar que haya un tipo de comprobante y número válido
        if (string.IsNullOrWhiteSpace(_saleDraft.TipoComprobante) || string.IsNullOrWhiteSpace(_saleDraft.NumeroComprobante))
        {
            _comprobanteError = "Debe seleccionar tipo de comprobante";
            StateHasChanged();
            return;
        }
        
        // Asegurar que todas las líneas nuevas estén en la venta actual
        foreach (var line in _newLines)
        {
            if (!_saleDraft.Lines.Contains(line))
            {
                _saleDraft.Lines.Add(line);
            }
        }
        _newLines.Clear();
        
        // Guardar la venta
        await SaveSale();
        
        // Limpiar el error si se guardó correctamente
        if (string.IsNullOrWhiteSpace(_error))
        {
            _comprobanteError = null;
        }
    }

    // Propiedades de paginación
    private int TotalPages => (int)Math.Ceiling((double)_newLines.Count / _pageSize);
    
    private IEnumerable<SaleLine> PaginatedLines
    {
        get
        {
            // Asegurar que la página actual sea válida
            if (_currentPage > TotalPages && TotalPages > 0)
            {
                _currentPage = TotalPages;
            }
            else if (_currentPage < 1)
            {
                _currentPage = 1;
            }
            
            var skip = (_currentPage - 1) * _pageSize;
            return _newLines.Skip(skip).Take(_pageSize);
        }
    }
    
    private void GoToPage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            _currentPage = page;
            StateHasChanged();
        }
    }

