        margin: 0 25px;
        border-radius: 4px;
        background: #f8f9fa;
    }
    
    .invoice-type-letter {
        font-size: 36px;
        font-weight: bold;
        line-height: 1;
        color: #333;
    }
    
    .invoice-type-code {
        font-size: 9px;
        color: #666;
        margin-top: 2px;
    }
    
