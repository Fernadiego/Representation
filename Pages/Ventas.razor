        if (e.Key == "Enter" && _filteredVendedores.Any())
        {
            var vendorToSelect = _hoveredVendedorIndex >= 0 && _hoveredVendedorIndex < _filteredVendedores.Count
                ? _filteredVendedores[_hoveredVendedorIndex]
                : _filteredVendedores.First();
            SelectVendedor(vendorToSelect);
        }
        else if (e.Key == "ArrowDown")
        {
            if (_hoveredVendedorIndex < _filteredVendedores.Count - 1)
            {
                _hoveredVendedorIndex++;
                _showVendedorDropdown = true;
            }
        }
        else if (e.Key == "ArrowUp")
        {
            if (_hoveredVendedorIndex > 0)
            {
                _hoveredVendedorIndex--;
            }
        }
        else if (e.Key == "Escape")
        {
            _showVendedorDropdown = false;
        }
    }
    
