@page "/zonas"
@using Microsoft.AspNetCore.Components.Web
@using BlazorVentas.Data
@inject CommerceService Commerce
@inject IJSRuntime JSRuntime
@inject BlazorVentas.Services.SessionService SessionService

<PageTitle>ABM Zonas</PageTitle>

<style>
    .card-header h5 {
        font-size: 0.875rem;
    }
    
    .filter-label {
        font-size: 0.8125rem;
        color: #6c757d;
        margin-right: 0.5rem;
    }
    .filter-select {
        font-size: 0.875rem;
        border-radius: 6px;
        border: 1px solid #dee2e6;
        padding: 0.375rem 2rem 0.375rem 0.75rem;
        background-color: white;
        min-width: 140px;
    }
    .filter-select:focus {
        border-color: #7c3aed;
        box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.1);
    }
    
    .zonas-table {
        margin: 0;
    }
    .zonas-table th {
        font-size: 0.8125rem;
    }
    .zonas-table tbody tr {
        height: 40px !important;
    }
    .zonas-table tbody tr:nth-child(even) {
        background-color: #f8f9fa !important;
    }
    .zonas-table tbody tr:nth-child(odd) {
        background-color: #ffffff !important;
    }
    .zonas-table tbody tr:hover {
        background-color: #e9ecef !important;
    }
    .zonas-table tbody tr.table-active {
        background-color: #cfe2ff !important;
    }
    .zonas-table tbody td {
        padding: 0.3rem 0.5rem !important;
        vertical-align: middle !important;
    }
    
    /* Zona Cell */
    .zona-cell {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
    .zona-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 600;
        font-size: 0.875rem;
    }
    .zona-info {
        display: flex;
        flex-direction: column;
    }
    .zona-name {
        font-weight: 600;
        color: #3c4858;
        text-decoration: none;
        margin-bottom: 2px;
    }
    .zona-name:hover {
        color: #10b981;
    }
    .zona-code {
        font-size: 0.75rem;
        color: #9ca3af;
    }
    
    /* Status Badges */
    .status-badge {
        font-size: 0.75rem;
        font-weight: 500;
        padding: 0.35rem 0.75rem;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }
    .status-badge::before {
        content: '';
        width: 6px;
        height: 6px;
        border-radius: 50%;
    }
    .status-active {
        background-color: #d1fae5;
        color: #059669;
    }
    .status-active::before {
        background-color: #10b981;
    }
    .status-inactive {
        background-color: #fee2e2;
        color: #dc2626;
    }
    .status-inactive::before {
        background-color: #ef4444;
    }
    
    /* Actions */
    .action-btn {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        border: none;
        background: transparent;
        color: #6c757d;
        transition: all 0.2s ease;
        cursor: pointer;
    }
    .action-btn:hover {
        background-color: #f1f3f5;
    }
    .action-btn.edit:hover {
        color: #10b981;
        background-color: #d1fae5;
    }
    .action-btn.delete:hover {
        color: #dc3545;
        background-color: #fee2e2;
    }
    
    /* Checkbox */
    .zona-checkbox {
        width: 18px;
        height: 18px;
        border-radius: 4px;
        cursor: pointer;
        accent-color: #10b981;
    }
    
    /* Pagination */
    .pagination-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem;
        border-top: 1px solid #e9ecef;
    }
    .pagination-info {
        font-size: 0.875rem;
        color: #6c757d;
    }
    .pagination-buttons {
        display: flex;
        gap: 0.25rem;
    }
    .page-btn {
        min-width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #dee2e6;
        background: white;
        border-radius: 6px;
        font-size: 0.875rem;
        color: #6c757d;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .page-btn:hover:not(.active):not(:disabled) {
        background-color: #f8f9fa;
        border-color: #10b981;
        color: #10b981;
    }
    .page-btn.active {
        background: #10b981;
        border-color: #10b981;
        color: white;
    }
    .page-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
    
    /* Search */
    .search-box {
        position: relative;
    }
    .search-box input {
        padding-left: 2.5rem;
        border-radius: 6px;
        border: 1px solid #dee2e6;
        font-size: 0.875rem;
        height: 38px;
        width: 250px;
    }
    .search-box input:focus {
        border-color: #10b981;
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1);
    }
    .search-box .search-icon {
        position: absolute;
        left: 0.75rem;
        top: 50%;
        transform: translateY(-50%);
        color: #9ca3af;
    }
    
    /* Modal Styles */
    .modal-header {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: white;
        border-radius: 8px 8px 0 0;
    }
    .modal-header .btn-close {
        filter: brightness(0) invert(1);
    }
    .modal-content {
        border: none;
        border-radius: 8px;
    }
    .form-label {
        font-weight: 500;
        color: #4b5563;
        font-size: 0.875rem;
    }
    .form-control, .form-select {
        border-radius: 6px;
        font-size: 0.875rem;
    }
    .form-control:focus, .form-select:focus {
        border-color: #10b981;
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1);
    }
    
    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
    }
    .empty-state-icon {
        font-size: 4rem;
        color: #d1d5db;
        margin-bottom: 1rem;
    }
    .empty-state-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: #4b5563;
        margin-bottom: 0.5rem;
    }
    .empty-state-text {
        color: #9ca3af;
        margin-bottom: 1.5rem;
    }
    
    .btn-primary {
        background-color: #10b981 !important;
        border-color: #10b981 !important;
    }
    .btn-primary:hover {
        background-color: #059669 !important;
        border-color: #059669 !important;
    }
</style>

<!-- Filters -->
<div class="card shadow-sm">
    <div class="card-header py-2">
        <h5 class="mb-0">
            <span class="oi oi-map-marker me-2"></span>ABM Zonas
        </h5>
    </div>
    <div class="card-body py-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex flex-wrap align-items-center gap-3">
                <span class="filter-label">Filtrar por:</span>
                
                <select class="filter-select" @bind="_filterEstado">
                    <option value="">Todos los Estados</option>
                    <option value="active">Activo</option>
                    <option value="inactive">Inactivo</option>
                </select>
                
                <div class="search-box">
                    <span class="search-icon oi oi-magnifying-glass"></span>
                    <input type="text" class="form-control" placeholder="Buscar zonas..." 
                           @bind="_searchText" @bind:event="oninput" />
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Zonas Table -->
<div class="card shadow-sm mt-3" style="flex: 1; display: flex; flex-direction: column; min-height: 0;">
    <div class="card-header d-flex justify-content-between align-items-center py-2">
        <h5 class="mb-0">Listado de Zonas</h5>
        <button class="btn btn-sm btn-primary" @onclick="OpenAddModal">
            <span class="oi oi-plus"></span> Agregar Zona
        </button>
    </div>
    @if (_loading)
    {
        <div class="d-flex justify-content-center align-items-center py-5">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (!FilteredZonas.Any())
    {
        <div class="empty-state">
            <div class="empty-state-icon">
                <span class="oi oi-map-marker"></span>
            </div>
            <h3 class="empty-state-title">No hay zonas</h3>
            <p class="empty-state-text">Comienza agregando tu primera zona.</p>
            <button class="btn btn-sm btn-primary" @onclick="OpenAddModal">
                <span class="oi oi-plus"></span> Agregar Zona
            </button>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0 zonas-table">
                <thead>
                    <tr>
                        <th style="width: 40px;">
                            <input type="checkbox" class="zona-checkbox" 
                                   @bind="_selectAll" @bind:after="ToggleSelectAll" />
                        </th>
                        <th>Zona</th>
                        <th>Código</th>
                        <th>Fecha Alta</th>
                        <th>Estado</th>
                        <th style="width: 100px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var zona in PaginatedZonas)
                    {
                        <tr>
                            <td>
                                <input type="checkbox" class="zona-checkbox" 
                                       checked="@_selectedZonas.Contains(zona.Id)"
                                       @onchange="() => ToggleZonaSelection(zona.Id)" />
                            </td>
                            <td>
                                <div class="zona-cell">
                                    <div class="zona-avatar">
                                        @GetInitials(zona.Descripcion)
                                    </div>
                                    <div class="zona-info">
                                        <a href="#" class="zona-name" @onclick:preventDefault @onclick="() => OpenEditModal(zona)">@zona.Descripcion</a>
                                        <span class="zona-code">ID: @zona.Id</span>
                                    </div>
                                </div>
                            </td>
                            <td>@zona.Codigo</td>
                            <td>@zona.FechaAlta.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="status-badge @(zona.Activo ? "status-active" : "status-inactive")">
                                    @(zona.Activo ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td>
                                <button class="action-btn edit" title="Editar" @onclick="() => OpenEditModal(zona)">
                                    <span class="oi oi-pencil"></span>
                                </button>
                                <button class="action-btn delete" title="Eliminar" @onclick="() => ConfirmDelete(zona)">
                                    <span class="oi oi-trash"></span>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <!-- Pagination -->
        <div class="pagination-container">
            <div class="pagination-info">
                Mostrando @((_currentPage - 1) * _pageSize + 1) a @Math.Min(_currentPage * _pageSize, FilteredZonas.Count()) de @FilteredZonas.Count() zonas
            </div>
            <div class="pagination-buttons">
                <button class="page-btn" disabled="@(_currentPage == 1)" @onclick="() => GoToPage(_currentPage - 1)">
                    <span class="oi oi-chevron-left"></span>
                </button>
                @for (int i = 1; i <= TotalPages; i++)
                {
                    var pageNum = i;
                    <button class="page-btn @(pageNum == _currentPage ? "active" : "")" @onclick="() => GoToPage(pageNum)">
                        @pageNum
                    </button>
                }
                <button class="page-btn" disabled="@(_currentPage == TotalPages)" @onclick="() => GoToPage(_currentPage + 1)">
                    <span class="oi oi-chevron-right"></span>
                </button>
            </div>
        </div>
    }
</div>

<!-- Modal Agregar/Editar -->
@if (_showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <span class="oi @(_isEditing ? "oi-pencil" : "oi-plus") me-2"></span>
                        @(_isEditing ? "Editar Zona" : "Nueva Zona")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_modalError))
                    {
                        <div class="alert alert-danger">@_modalError</div>
                    }
                    
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Código <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" @bind="_editZona.Codigo" placeholder="Ej: ZN001" maxlength="20" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Estado</label>
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" @bind="_editZona.Activo" style="width: 3em; height: 1.5em;">
                                <label class="form-check-label ms-2">@(_editZona.Activo ? "Activo" : "Inactivo")</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Descripción <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" @bind="_editZona.Descripcion" placeholder="Nombre de la zona" maxlength="100" />
                        </div>
                        @if (_isEditing)
                        {
                            <div class="col-12">
                                <label class="form-label">Fecha de Alta</label>
                                <input type="text" class="form-control" value="@_editZona.FechaAlta.ToString("dd/MM/yyyy HH:mm")" disabled />
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveZona">
                        <span class="oi oi-check me-1"></span>@(_isEditing ? "Guardar Cambios" : "Crear Zona")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Confirmar Eliminación -->
@if (_showDeleteModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <span class="oi oi-warning me-2"></span>Confirmar Eliminación
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showDeleteModal = false"></button>
                </div>
                <div class="modal-body">
                    <p>¿Está seguro que desea eliminar la zona <strong>@_deleteZona?.Descripcion</strong>?</p>
                    <p class="text-muted small">Esta acción no se puede deshacer.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => _showDeleteModal = false">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteZona">
                        <span class="oi oi-trash me-1"></span>Eliminar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ZonaItem> _zonas = new();
    private bool _loading = true;
    private string _searchText = string.Empty;
    private string _filterEstado = string.Empty;
    
    // Paginación
    private int _currentPage = 1;
    private int _pageSize = 10;
    
    // Selección
    private bool _selectAll;
    private HashSet<int> _selectedZonas = new();
    
    // Modal
    private bool _showModal = false;
    private bool _isEditing = false;
    private ZonaItem _editZona = new();
    private string? _modalError;
    
    // Modal eliminar
    private bool _showDeleteModal = false;
    private ZonaItem? _deleteZona;
    
    private IEnumerable<ZonaItem> FilteredZonas => _zonas
        .Where(z => string.IsNullOrEmpty(_searchText) || 
                    z.Descripcion.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                    z.Codigo.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
        .Where(z => string.IsNullOrEmpty(_filterEstado) ||
                    (_filterEstado == "active" && z.Activo) ||
                    (_filterEstado == "inactive" && !z.Activo))
        .OrderBy(z => z.Descripcion);
    
    private IEnumerable<ZonaItem> PaginatedZonas => FilteredZonas
        .Skip((_currentPage - 1) * _pageSize)
        .Take(_pageSize);
    
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredZonas.Count() / (double)_pageSize));
    
    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }
    
    private async Task LoadDataAsync()
    {
        _loading = true;
        StateHasChanged();
        
        try
        {
            _zonas = await Commerce.GetZonasAsync();
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }
    
    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return name.Length >= 2 ? name.Substring(0, 2).ToUpper() : name.ToUpper();
    }
    
    private void GoToPage(int page)
    {
        _currentPage = Math.Max(1, Math.Min(page, TotalPages));
    }
    
    private void ToggleSelectAll()
    {
        if (_selectAll)
        {
            _selectedZonas = FilteredZonas.Select(z => z.Id).ToHashSet();
        }
        else
        {
            _selectedZonas.Clear();
        }
    }
    
    private void ToggleZonaSelection(int zonaId)
    {
        if (_selectedZonas.Contains(zonaId))
            _selectedZonas.Remove(zonaId);
        else
            _selectedZonas.Add(zonaId);
        
        _selectAll = FilteredZonas.All(z => _selectedZonas.Contains(z.Id));
    }
    
    private void OpenAddModal()
    {
        _isEditing = false;
        var nextCodigo = _zonas.Any() ? $"ZN{(_zonas.Max(z => z.Id) + 1):D3}" : "ZN001";
        _editZona = new ZonaItem
        {
            Codigo = nextCodigo,
            Activo = true,
            FechaAlta = DateTime.Now
        };
        _modalError = null;
        _showModal = true;
    }
    
    private void OpenEditModal(ZonaItem zona)
    {
        _isEditing = true;
        _editZona = new ZonaItem
        {
            Id = zona.Id,
            Codigo = zona.Codigo,
            Descripcion = zona.Descripcion,
            Activo = zona.Activo,
            FechaAlta = zona.FechaAlta
        };
        _modalError = null;
        _showModal = true;
    }
    
    private void CloseModal()
    {
        _showModal = false;
        _modalError = null;
    }
    
    private async Task SaveZona()
    {
        if (string.IsNullOrWhiteSpace(_editZona.Codigo))
        {
            _modalError = "El código es requerido";
            return;
        }
        
        if (string.IsNullOrWhiteSpace(_editZona.Descripcion))
        {
            _modalError = "La descripción es requerida";
            return;
        }
        
        // Validar código único
        if (!_isEditing && _zonas.Any(z => z.Codigo.Equals(_editZona.Codigo, StringComparison.OrdinalIgnoreCase)))
        {
            _modalError = "Ya existe una zona con ese código";
            return;
        }
        
        if (_isEditing && _zonas.Any(z => z.Id != _editZona.Id && z.Codigo.Equals(_editZona.Codigo, StringComparison.OrdinalIgnoreCase)))
        {
            _modalError = "Ya existe otra zona con ese código";
            return;
        }
        
        try
        {
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
            var usuarioId = token != null ? await SessionService.GetUsuarioIdAsync(token) : null;
            await Commerce.SaveZonaAsync(_editZona, usuarioId);
            
            await LoadDataAsync();
            CloseModal();
        }
        catch (Exception ex)
        {
            _modalError = $"Error al guardar: {ex.Message}";
        }
    }
    
    private void ConfirmDelete(ZonaItem zona)
    {
        _deleteZona = zona;
        _showDeleteModal = true;
    }
    
    private async Task DeleteZona()
    {
        if (_deleteZona == null) return;
        
        try
        {
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
            var usuarioId = token != null ? await SessionService.GetUsuarioIdAsync(token) : null;
            await Commerce.DeleteZonaAsync(_deleteZona.Id, usuarioId);
            await LoadDataAsync();
            _showDeleteModal = false;
            _deleteZona = null;
        }
        catch (Exception ex)
        {
            // Manejar error - podría ser por restricción de FK
            _modalError = $"No se puede eliminar: {ex.Message}";
        }
    }
}

