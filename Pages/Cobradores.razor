@page "/cobradores"
@using Microsoft.AspNetCore.Components.Web
@using BlazorVentas.Data
@inject CommerceService Commerce
@inject IJSRuntime JSRuntime
@inject BlazorVentas.Services.SessionService SessionService

<PageTitle>ABM Cobradores</PageTitle>

<style>
    .card-header h5 {
        font-size: 0.875rem;
    }
    
    .filter-label {
        font-size: 0.8125rem;
        color: #6c757d;
        margin-right: 0.5rem;
    }
    .filter-select {
        font-size: 0.875rem;
        border-radius: 6px;
        border: 1px solid #dee2e6;
        padding: 0.375rem 2rem 0.375rem 0.75rem;
        background-color: white;
        min-width: 140px;
    }
    .filter-select:focus {
        border-color: #f59e0b;
        box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.1);
    }
    
    .cobradores-table {
        margin: 0;
    }
    .cobradores-table th {
        font-size: 0.8125rem;
    }
    .cobradores-table tbody tr {
        height: 40px !important;
    }
    .cobradores-table tbody tr:nth-child(even) {
        background-color: #f8f9fa !important;
    }
    .cobradores-table tbody tr:nth-child(odd) {
        background-color: #ffffff !important;
    }
    .cobradores-table tbody tr:hover {
        background-color: #e9ecef !important;
    }
    .cobradores-table tbody tr.table-active {
        background-color: #fef3c7 !important;
    }
    .cobradores-table tbody td {
        padding: 0.3rem 0.5rem !important;
        vertical-align: middle !important;
    }
    
    /* Cobrador Cell */
    .cobrador-cell {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
    .cobrador-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 600;
        font-size: 0.875rem;
    }
    .cobrador-info {
        display: flex;
        flex-direction: column;
    }
    .cobrador-name {
        font-weight: 600;
        color: #3c4858;
        text-decoration: none;
        margin-bottom: 2px;
    }
    .cobrador-name:hover {
        color: #f59e0b;
    }
    .cobrador-code {
        font-size: 0.75rem;
        color: #9ca3af;
    }
    
    /* Status Badges */
    .status-badge {
        font-size: 0.75rem;
        font-weight: 500;
        padding: 0.35rem 0.75rem;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }
    .status-badge::before {
        content: '';
        width: 6px;
        height: 6px;
        border-radius: 50%;
    }
    .status-active {
        background-color: #d1fae5;
        color: #059669;
    }
    .status-active::before {
        background-color: #10b981;
    }
    .status-inactive {
        background-color: #fee2e2;
        color: #dc2626;
    }
    .status-inactive::before {
        background-color: #ef4444;
    }
    
    /* Actions */
    .action-btn {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        border: none;
        background: transparent;
        color: #6c757d;
        transition: all 0.2s ease;
        cursor: pointer;
    }
    .action-btn:hover {
        background-color: #f1f3f5;
    }
    .action-btn.edit:hover {
        color: #f59e0b;
        background-color: #fef3c7;
    }
    .action-btn.delete:hover {
        color: #dc3545;
        background-color: #fee2e2;
    }
    
    /* Checkbox */
    .cobrador-checkbox {
        width: 18px;
        height: 18px;
        border-radius: 4px;
        cursor: pointer;
        accent-color: #f59e0b;
    }
    
    /* Pagination */
    .pagination-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem;
        border-top: 1px solid #e9ecef;
    }
    .pagination-info {
        font-size: 0.875rem;
        color: #6c757d;
    }
    .pagination-buttons {
        display: flex;
        gap: 0.25rem;
    }
    .page-btn {
        min-width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #dee2e6;
        background: white;
        border-radius: 6px;
        font-size: 0.875rem;
        color: #6c757d;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .page-btn:hover:not(.active):not(:disabled) {
        background-color: #f8f9fa;
        border-color: #f59e0b;
        color: #f59e0b;
    }
    .page-btn.active {
        background: #f59e0b;
        border-color: #f59e0b;
        color: white;
    }
    .page-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
    
    /* Search */
    .search-box {
        position: relative;
    }
    .search-box input {
        padding-left: 2.5rem;
        border-radius: 6px;
        border: 1px solid #dee2e6;
        font-size: 0.875rem;
        height: 38px;
        width: 250px;
    }
    .search-box input:focus {
        border-color: #f59e0b;
        box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.1);
    }
    .search-box .search-icon {
        position: absolute;
        left: 0.75rem;
        top: 50%;
        transform: translateY(-50%);
        color: #9ca3af;
    }
    
    /* Modal Styles */
    .modal-header {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: white;
        border-radius: 8px 8px 0 0;
    }
    .modal-header .btn-close {
        filter: brightness(0) invert(1);
    }
    .modal-content {
        border: none;
        border-radius: 8px;
    }
    .form-label {
        font-weight: 500;
        color: #4b5563;
        font-size: 0.875rem;
    }
    .form-control, .form-select {
        border-radius: 6px;
        font-size: 0.875rem;
    }
    .form-control:focus, .form-select:focus {
        border-color: #f59e0b;
        box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.1);
    }
    
    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
    }
    .empty-state-icon {
        font-size: 4rem;
        color: #d1d5db;
        margin-bottom: 1rem;
    }
    .empty-state-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: #4b5563;
        margin-bottom: 0.5rem;
    }
    .empty-state-text {
        color: #9ca3af;
        margin-bottom: 1.5rem;
    }
    
    .btn-primary {
        background-color: #f59e0b !important;
        border-color: #f59e0b !important;
    }
    .btn-primary:hover {
        background-color: #d97706 !important;
        border-color: #d97706 !important;
    }
</style>

<!-- Filters -->
<div class="card shadow-sm">
    <div class="card-header py-2">
        <h5 class="mb-0">
            <span class="oi oi-credit-card me-2"></span>ABM Cobradores
        </h5>
    </div>
    <div class="card-body py-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex flex-wrap align-items-center gap-3">
                <span class="filter-label">Filtrar por:</span>
                
                <select class="filter-select" @bind="_filterEstado">
                    <option value="">Todos los Estados</option>
                    <option value="active">Activo</option>
                    <option value="inactive">Inactivo</option>
                </select>
                
                <div class="search-box">
                    <span class="search-icon oi oi-magnifying-glass"></span>
                    <input type="text" class="form-control" placeholder="Buscar cobradores..." 
                           @bind="_searchText" @bind:event="oninput" />
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Cobradores Table -->
<div class="card shadow-sm mt-3" style="flex: 1; display: flex; flex-direction: column; min-height: 0;">
    <div class="card-header d-flex justify-content-between align-items-center py-2">
        <h5 class="mb-0">Listado de Cobradores</h5>
        <button class="btn btn-sm btn-primary" @onclick="OpenAddModal">
            <span class="oi oi-plus"></span> Agregar Cobrador
        </button>
    </div>
    @if (_loading)
    {
        <div class="d-flex justify-content-center align-items-center py-5">
            <div class="spinner-border" style="color: #f59e0b;" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (!FilteredCobradores.Any())
    {
        <div class="empty-state">
            <div class="empty-state-icon">
                <span class="oi oi-credit-card"></span>
            </div>
            <h3 class="empty-state-title">No hay cobradores</h3>
            <p class="empty-state-text">Comienza agregando tu primer cobrador.</p>
            <button class="btn btn-sm btn-primary" @onclick="OpenAddModal">
                <span class="oi oi-plus"></span> Agregar Cobrador
            </button>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0 cobradores-table">
                <thead>
                    <tr>
                        <th style="width: 40px;">
                            <input type="checkbox" class="cobrador-checkbox" 
                                   @bind="_selectAll" @bind:after="ToggleSelectAll" />
                        </th>
                        <th>Cobrador</th>
                        <th>Código</th>
                        <th>Fecha Alta</th>
                        <th>Estado</th>
                        <th style="width: 100px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cobrador in PaginatedCobradores)
                    {
                        <tr>
                            <td>
                                <input type="checkbox" class="cobrador-checkbox" 
                                       checked="@_selectedCobradores.Contains(cobrador.Id)"
                                       @onchange="() => ToggleCobradorSelection(cobrador.Id)" />
                            </td>
                            <td>
                                <div class="cobrador-cell">
                                    <div class="cobrador-avatar">
                                        @GetInitials(cobrador.Nombre)
                                    </div>
                                    <div class="cobrador-info">
                                        <a href="#" class="cobrador-name" @onclick:preventDefault @onclick="() => OpenEditModal(cobrador)">@cobrador.Nombre</a>
                                        <span class="cobrador-code">ID: @cobrador.Id</span>
                                    </div>
                                </div>
                            </td>
                            <td>@cobrador.Codigo</td>
                            <td>@cobrador.FechaAlta.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="status-badge @(cobrador.Activo ? "status-active" : "status-inactive")">
                                    @(cobrador.Activo ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td>
                                <button class="action-btn edit" title="Editar" @onclick="() => OpenEditModal(cobrador)">
                                    <span class="oi oi-pencil"></span>
                                </button>
                                <button class="action-btn delete" title="Eliminar" @onclick="() => ConfirmDelete(cobrador)">
                                    <span class="oi oi-trash"></span>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <!-- Pagination -->
        <div class="pagination-container">
            <div class="pagination-info">
                Mostrando @((_currentPage - 1) * _pageSize + 1) a @Math.Min(_currentPage * _pageSize, FilteredCobradores.Count()) de @FilteredCobradores.Count() cobradores
            </div>
            <div class="pagination-buttons">
                <button class="page-btn" disabled="@(_currentPage == 1)" @onclick="() => GoToPage(_currentPage - 1)">
                    <span class="oi oi-chevron-left"></span>
                </button>
                @for (int i = 1; i <= TotalPages; i++)
                {
                    var pageNum = i;
                    <button class="page-btn @(pageNum == _currentPage ? "active" : "")" @onclick="() => GoToPage(pageNum)">
                        @pageNum
                    </button>
                }
                <button class="page-btn" disabled="@(_currentPage == TotalPages)" @onclick="() => GoToPage(_currentPage + 1)">
                    <span class="oi oi-chevron-right"></span>
                </button>
            </div>
        </div>
    }
</div>

<!-- Modal Agregar/Editar -->
@if (_showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <span class="oi @(_isEditing ? "oi-pencil" : "oi-plus") me-2"></span>
                        @(_isEditing ? "Editar Cobrador" : "Nuevo Cobrador")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_modalError))
                    {
                        <div class="alert alert-danger">@_modalError</div>
                    }
                    
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Código <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" @bind="_editCobrador.Codigo" placeholder="Ej: COB001" maxlength="20" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Estado</label>
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" @bind="_editCobrador.Activo" style="width: 3em; height: 1.5em;">
                                <label class="form-check-label ms-2">@(_editCobrador.Activo ? "Activo" : "Inactivo")</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Nombre <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" @bind="_editCobrador.Nombre" placeholder="Nombre del cobrador" maxlength="100" />
                        </div>
                        @if (_isEditing)
                        {
                            <div class="col-md-6">
                                <label class="form-label">Fecha de Alta</label>
                                <input type="text" class="form-control" value="@_editCobrador.FechaAlta.ToString("dd/MM/yyyy HH:mm")" disabled />
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveCobrador">
                        <span class="oi oi-check me-1"></span>@(_isEditing ? "Guardar Cambios" : "Crear Cobrador")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Confirmar Eliminación -->
@if (_showDeleteModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <span class="oi oi-warning me-2"></span>Confirmar Eliminación
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _showDeleteModal = false"></button>
                </div>
                <div class="modal-body">
                    <p>¿Está seguro que desea eliminar al cobrador <strong>@_deleteCobrador?.Nombre</strong>?</p>
                    <p class="text-muted small">Esta acción no se puede deshacer.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => _showDeleteModal = false">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteCobrador">
                        <span class="oi oi-trash me-1"></span>Eliminar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<CobradorItem> _cobradores = new();
    private bool _loading = true;
    private string _searchText = string.Empty;
    private string _filterEstado = string.Empty;
    
    // Paginación
    private int _currentPage = 1;
    private int _pageSize = 10;
    
    // Selección
    private bool _selectAll;
    private HashSet<int> _selectedCobradores = new();
    
    // Modal
    private bool _showModal = false;
    private bool _isEditing = false;
    private CobradorItem _editCobrador = new();
    private string? _modalError;
    
    // Modal eliminar
    private bool _showDeleteModal = false;
    private CobradorItem? _deleteCobrador;
    
    private IEnumerable<CobradorItem> FilteredCobradores => _cobradores
        .Where(c => string.IsNullOrEmpty(_searchText) || 
                    c.Nombre.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                    c.Codigo.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
        .Where(c => string.IsNullOrEmpty(_filterEstado) ||
                    (_filterEstado == "active" && c.Activo) ||
                    (_filterEstado == "inactive" && !c.Activo))
        .OrderBy(c => c.Nombre);
    
    private IEnumerable<CobradorItem> PaginatedCobradores => FilteredCobradores
        .Skip((_currentPage - 1) * _pageSize)
        .Take(_pageSize);
    
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredCobradores.Count() / (double)_pageSize));
    
    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }
    
    private async Task LoadDataAsync()
    {
        _loading = true;
        StateHasChanged();
        
        try
        {
            _cobradores = await Commerce.GetCobradoresAsync();
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }
    
    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return name.Length >= 2 ? name.Substring(0, 2).ToUpper() : name.ToUpper();
    }
    
    private void GoToPage(int page)
    {
        _currentPage = Math.Max(1, Math.Min(page, TotalPages));
    }
    
    private void ToggleSelectAll()
    {
        if (_selectAll)
        {
            _selectedCobradores = FilteredCobradores.Select(c => c.Id).ToHashSet();
        }
        else
        {
            _selectedCobradores.Clear();
        }
    }
    
    private void ToggleCobradorSelection(int cobradorId)
    {
        if (_selectedCobradores.Contains(cobradorId))
            _selectedCobradores.Remove(cobradorId);
        else
            _selectedCobradores.Add(cobradorId);
        
        _selectAll = FilteredCobradores.All(c => _selectedCobradores.Contains(c.Id));
    }
    
    private void OpenAddModal()
    {
        _isEditing = false;
        var nextCodigo = _cobradores.Any() ? $"COB{(_cobradores.Max(c => c.Id) + 1):D3}" : "COB001";
        _editCobrador = new CobradorItem
        {
            Codigo = nextCodigo,
            Activo = true,
            FechaAlta = DateTime.Now
        };
        _modalError = null;
        _showModal = true;
    }
    
    private void OpenEditModal(CobradorItem cobrador)
    {
        _isEditing = true;
        _editCobrador = new CobradorItem
        {
            Id = cobrador.Id,
            Codigo = cobrador.Codigo,
            Nombre = cobrador.Nombre,
            Activo = cobrador.Activo,
            FechaAlta = cobrador.FechaAlta
        };
        _modalError = null;
        _showModal = true;
    }
    
    private void CloseModal()
    {
        _showModal = false;
        _modalError = null;
    }
    
    private async Task SaveCobrador()
    {
        if (string.IsNullOrWhiteSpace(_editCobrador.Codigo))
        {
            _modalError = "El código es requerido";
            return;
        }
        
        if (string.IsNullOrWhiteSpace(_editCobrador.Nombre))
        {
            _modalError = "El nombre es requerido";
            return;
        }
        
        // Validar código único
        if (!_isEditing && _cobradores.Any(c => c.Codigo.Equals(_editCobrador.Codigo, StringComparison.OrdinalIgnoreCase)))
        {
            _modalError = "Ya existe un cobrador con ese código";
            return;
        }
        
        if (_isEditing && _cobradores.Any(c => c.Id != _editCobrador.Id && c.Codigo.Equals(_editCobrador.Codigo, StringComparison.OrdinalIgnoreCase)))
        {
            _modalError = "Ya existe otro cobrador con ese código";
            return;
        }
        
        try
        {
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
            var usuarioId = token != null ? await SessionService.GetUsuarioIdAsync(token) : null;
            await Commerce.SaveCobradorAsync(_editCobrador, usuarioId);
            
            await LoadDataAsync();
            CloseModal();
        }
        catch (Exception ex)
        {
            _modalError = $"Error al guardar: {ex.Message}";
        }
    }
    
    private void ConfirmDelete(CobradorItem cobrador)
    {
        _deleteCobrador = cobrador;
        _showDeleteModal = true;
    }
    
    private async Task DeleteCobrador()
    {
        if (_deleteCobrador == null) return;
        
        try
        {
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
            var usuarioId = token != null ? await SessionService.GetUsuarioIdAsync(token) : null;
            await Commerce.DeleteCobradorAsync(_deleteCobrador.Id, usuarioId);
            await LoadDataAsync();
            _showDeleteModal = false;
            _deleteCobrador = null;
        }
        catch (Exception ex)
        {
            _modalError = $"No se puede eliminar: {ex.Message}";
        }
    }
}

