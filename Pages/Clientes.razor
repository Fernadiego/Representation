@page "/clientes"
@inject CommerceService Commerce
@inject TenantState TenantState
@implements IDisposable

<PageTitle>Clientes</PageTitle>

<h1 class="mb-4">Clientes</h1>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="mb-0">@(_editingCustomer.Id == 0 ? "Nuevo cliente" : $"Editar #{_editingCustomer.Id}")</h5>
            </div>
            <div class="card-body">
                <EditForm Model="_editingCustomer" OnValidSubmit="SaveCustomer">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <InputText class="form-control" @bind-Value="_editingCustomer.Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Correo</label>
                        <InputText class="form-control" @bind-Value="_editingCustomer.Email" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Teléfono</label>
                        <InputText class="form-control" @bind-Value="_editingCustomer.Phone" />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Guardar</button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="ResetForm">Cancelar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Listado</h5>
                <span class="badge text-bg-secondary">@_customers.Count clientes</span>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Teléfono</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!_customers.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">Sin clientes</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var customer in _customers)
                            {
                                <tr>
                                    <td>@customer.Name</td>
                                    <td>@customer.Email</td>
                                    <td>@customer.Phone</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-link" @onclick="() => EditCustomer(customer)">Editar</button>
                                        <button class="btn btn-sm btn-link text-danger" @onclick="() => DeleteCustomer(customer.Id)">Eliminar</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Customer> _customers = new();
    private Customer _editingCustomer = new();

    protected override async Task OnInitializedAsync()
    {
        TenantState.OnTenantChanged += HandleTenantChanged;
        await LoadCustomers(resetForm: true);
    }

    public void Dispose()
    {
        TenantState.OnTenantChanged -= HandleTenantChanged;
    }

    private async Task LoadCustomers(bool resetForm = false)
    {
        var companyId = TenantState.CurrentCompanyId;
        if (companyId is null)
        {
            _customers.Clear();
            if (resetForm)
            {
                ResetForm();
            }
            return;
        }

        _customers = await Commerce.GetCustomersAsync(companyId.Value);
        if (resetForm)
        {
            ResetForm();
        }
    }

    private void ResetForm()
    {
        _editingCustomer = new Customer
        {
            CompanyId = TenantState.CurrentCompanyId ?? 0
        };
    }

    private void EditCustomer(Customer customer)
    {
        _editingCustomer = new Customer
        {
            Id = customer.Id,
            CompanyId = customer.CompanyId,
            Name = customer.Name,
            Email = customer.Email,
            Phone = customer.Phone
        };
    }

    private async Task SaveCustomer()
    {
        if (TenantState.CurrentCompanyId is not int companyId)
        {
            return;
        }

        await Commerce.SaveCustomerAsync(companyId, _editingCustomer);
        await LoadCustomers(resetForm: true);
    }

    private async Task DeleteCustomer(int id)
    {
        if (TenantState.CurrentCompanyId is not int companyId)
        {
            return;
        }

        await Commerce.DeleteCustomerAsync(companyId, id);
        await LoadCustomers(resetForm: true);
    }

    private async void HandleTenantChanged(Company _)
    {
        await InvokeAsync(async () =>
        {
            await LoadCustomers(resetForm: true);
            StateHasChanged();
        });
    }
}

