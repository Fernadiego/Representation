@page "/vendedores"
@inject CommerceService Commerce
@inject TenantState TenantState
@implements IDisposable

<PageTitle>Vendedores</PageTitle>

<h1 class="mb-4">Vendedores</h1>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="mb-0">@(_editingVendor.Id == 0 ? "Nuevo vendedor" : $"Editar #{_editingVendor.Id}")</h5>
            </div>
            <div class="card-body">
                <EditForm Model="_editingVendor" OnValidSubmit="SaveVendor">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <InputText class="form-control" @bind-Value="_editingVendor.Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">% Comisión</label>
                        <InputNumber class="form-control" @bind-Value="_editingVendor.CommissionRate" />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Guardar</button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="ResetForm">Cancelar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Listado</h5>
                <span class="badge text-bg-secondary">@_vendors.Count vendedores</span>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Comisión</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!_vendors.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">Sin vendedores</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var vendor in _vendors)
                            {
                                <tr>
                                    <td>@vendor.Name</td>
                                    <td>@vendor.CommissionRate %</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-link" @onclick="() => EditVendor(vendor)">Editar</button>
                                        <button class="btn btn-sm btn-link text-danger" @onclick="() => DeleteVendor(vendor.Id)">Eliminar</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Vendor> _vendors = new();
    private Vendor _editingVendor = new();

    protected override async Task OnInitializedAsync()
    {
        TenantState.OnTenantChanged += HandleTenantChanged;
        await LoadVendors(resetForm: true);
    }

    public void Dispose()
    {
        TenantState.OnTenantChanged -= HandleTenantChanged;
    }

    private async Task LoadVendors(bool resetForm = false)
    {
        var companyId = TenantState.CurrentCompanyId;
        if (companyId is null)
        {
            _vendors.Clear();
            if (resetForm)
            {
                ResetForm();
            }
            return;
        }

        _vendors = await Commerce.GetVendorsAsync(companyId.Value);
        if (resetForm)
        {
            ResetForm();
        }
    }

    private void ResetForm()
    {
        _editingVendor = new Vendor
        {
            CompanyId = TenantState.CurrentCompanyId ?? 0
        };
    }

    private void EditVendor(Vendor vendor)
    {
        _editingVendor = new Vendor
        {
            Id = vendor.Id,
            CompanyId = vendor.CompanyId,
            Name = vendor.Name,
            CommissionRate = vendor.CommissionRate
        };
    }

    private async Task SaveVendor()
    {
        if (TenantState.CurrentCompanyId is not int companyId)
        {
            return;
        }

        await Commerce.SaveVendorAsync(companyId, _editingVendor);
        await LoadVendors(resetForm: true);
    }

    private async Task DeleteVendor(int id)
    {
        if (TenantState.CurrentCompanyId is not int companyId)
        {
            return;
        }

        await Commerce.DeleteVendorAsync(companyId, id);
        await LoadVendors(resetForm: true);
    }

    private async void HandleTenantChanged(Company _)
    {
        await InvokeAsync(async () =>
        {
            await LoadVendors(resetForm: true);
            StateHasChanged();
        });
    }
}

