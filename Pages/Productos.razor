@page "/productos"
@using System.IO
@inject CommerceService Commerce
@inject TenantState TenantState
@inject BlazorVentas.Services.ImageService ImageService
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Productos</PageTitle>

<h1 class="mb-4">Catálogo de productos</h1>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="mb-0">@(_editingProduct.Id == 0 ? "Nuevo producto" : $"Editar #{_editingProduct.Id}")</h5>
            </div>
            <div class="card-body">
                <EditForm Model="_editingProduct" OnValidSubmit="SaveProduct">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <InputText class="form-control" @bind-Value="_editingProduct.Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">SKU</label>
                        <InputText class="form-control" @bind-Value="_editingProduct.Sku" />
                    </div>
                    <div class="row mb-3">
                        <div class="col">
                            <label class="form-label">Precio Base</label>
                            <InputNumber class="form-control" @bind-Value="_editingProduct.UnitPrice" />
                        </div>
                        <div class="col">
                            <label class="form-label">Stock</label>
                            <InputNumber class="form-control" @bind-Value="_editingProduct.Stock" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Proveedor</label>
                        <InputSelect class="form-select" @bind-Value="_editingProduct.SupplierId">
                            <option value="0">Selecciona...</option>
                            @foreach (var supplier in _suppliers)
                            {
                                <option value="@supplier.Id">@supplier.Name</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Listas de Precios</label>
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label small">Lista 1</label>
                                <InputNumber class="form-control form-control-sm" @bind-Value="_editingProduct.PrecioLista1" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small">Lista 2</label>
                                <InputNumber class="form-control form-control-sm" @bind-Value="_editingProduct.PrecioLista2" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small">Lista 3</label>
                                <InputNumber class="form-control form-control-sm" @bind-Value="_editingProduct.PrecioLista3" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small">Lista 4</label>
                                <InputNumber class="form-control form-control-sm" @bind-Value="_editingProduct.PrecioLista4" />
                            </div>
                        </div>
                        <small class="text-muted">Si no se especifican, se usará el precio base</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Imagen del Producto</label>
                        <div class="d-flex align-items-center gap-3">
                            @if (!string.IsNullOrWhiteSpace(_editingProduct.ImagePath))
                            {
                                <img src="@_editingProduct.ImagePath" alt="Vista previa" class="img-thumbnail" style="width: 80px; height: 80px; object-fit: cover; border-radius: 50%;" />
                            }
                            else
                            {
                                <div class="img-thumbnail d-flex align-items-center justify-content-center" style="width: 80px; height: 80px; border-radius: 50%; background-color: #f0f0f0;">
                                    <span class="text-muted small">Sin imagen</span>
                                </div>
                            }
                            <div class="flex-grow-1">
                                <InputFile OnChange="HandleImageUpload" accept="image/*" class="form-control" />
                                <small class="text-muted">Formatos permitidos: JPG, PNG, GIF, WEBP</small>
                            </div>
                        </div>
                        @if (_isUploading)
                        {
                            <div class="mt-2">
                                <div class="spinner-border spinner-border-sm" role="status">
                                    <span class="visually-hidden">Subiendo...</span>
                                </div>
                                <span class="ms-2 small">Subiendo imagen...</span>
                            </div>
                        }
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Guardar</button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="ResetForm">Cancelar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Inventario</h5>
                <span class="badge text-bg-secondary">@_products.Count() registros</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>SKU</th>
                            <th>Proveedor</th>
                            <th class="text-end">Precio</th>
                            <th class="text-end">Stock</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!_products.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">Sin productos</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var product in _products)
                            {
                                <tr>
                                    <td>@product.Name</td>
                                    <td><span class="badge text-bg-light">@product.Sku</span></td>
                                    <td>@product.Supplier?.Name</td>
                                    <td class="text-end">@product.UnitPrice.ToString("C")</td>
                                    <td class="text-end">@product.Stock</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-link" @onclick="() => EditProduct(product)">Editar</button>
                                        <button class="btn btn-sm btn-link text-danger" @onclick="() => DeleteProduct(product.Id)">Eliminar</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Product> _products = new();
    private List<Supplier> _suppliers = new();
    private Product _editingProduct = new();
    private bool _isUploading = false;

    protected override async Task OnInitializedAsync()
    {
        TenantState.OnTenantChanged += HandleTenantChanged;
        await LoadData(resetForm: true);
    }

    public void Dispose()
    {
        TenantState.OnTenantChanged -= HandleTenantChanged;
    }

    private async Task LoadData(bool resetForm = false)
    {
        var companyId = TenantState.CurrentCompanyId;
        if (companyId is null)
        {
            _products.Clear();
            _suppliers.Clear();
            if (resetForm)
            {
                ResetForm();
            }
            return;
        }

        _products = await Commerce.GetProductsAsync(companyId.Value);
        _suppliers = await Commerce.GetSuppliersAsync(companyId.Value);

        if (resetForm)
        {
            ResetForm();
        }
    }

    private void ResetForm()
    {
        _editingProduct = new Product
        {
            CompanyId = TenantState.CurrentCompanyId ?? 0,
            SupplierId = _suppliers.FirstOrDefault()?.Id ?? 0,
            PrecioLista1 = 0,
            PrecioLista2 = 0,
            PrecioLista3 = 0,
            PrecioLista4 = 0
        };
    }

    private void EditProduct(Product product)
    {
        _editingProduct = new Product
        {
            Id = product.Id,
            CompanyId = product.CompanyId,
            Name = product.Name,
            Sku = product.Sku,
            UnitPrice = product.UnitPrice,
            Stock = product.Stock,
            SupplierId = product.SupplierId,
            PrecioLista1 = product.PrecioLista1,
            PrecioLista2 = product.PrecioLista2,
            PrecioLista3 = product.PrecioLista3,
            PrecioLista4 = product.PrecioLista4,
            ImagePath = product.ImagePath
        };
    }

    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        if (e.File == null || e.File.Size == 0)
            return;

        // Validar que es un archivo de imagen
        var validExtensions = new[] { ".jpg", ".jpeg", ".png", ".gif", ".webp" };
        var extension = Path.GetExtension(e.File.Name).ToLowerInvariant();
        if (!validExtensions.Contains(extension))
        {
            return;
        }

        // Si es un producto nuevo (sin ID), mostrar mensaje de que debe guardar primero
        if (_editingProduct.Id == 0)
        {
            // Guardar el producto primero para obtener el ID
            if (TenantState.CurrentCompanyId is not int companyId)
            {
                return;
            }
            
            // Guardar para obtener el ID
            await Commerce.SaveProductAsync(companyId, _editingProduct);
            await LoadData(resetForm: false);
            
            // Buscar el producto guardado por SKU y nombre
            var savedProduct = _products.FirstOrDefault(p => 
                p.Sku == _editingProduct.Sku && 
                p.Name == _editingProduct.Name &&
                p.CompanyId == companyId);
            
            if (savedProduct != null)
            {
                _editingProduct.Id = savedProduct.Id;
            }
            else
            {
                return; // No se pudo encontrar el producto guardado
            }
        }

        _isUploading = true;
        StateHasChanged();

        try
        {
            // Leer el stream del archivo
            using var stream = e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10MB max
            var imagePath = await ImageService.SaveProductImageAsync(stream, _editingProduct.Id, e.File.Name);
            
            if (!string.IsNullOrWhiteSpace(imagePath))
            {
                _editingProduct.ImagePath = imagePath;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            // Error al subir imagen - en producción podrías mostrar un mensaje al usuario
            Console.WriteLine($"Error al subir imagen: {ex.Message}");
        }
        finally
        {
            _isUploading = false;
            StateHasChanged();
        }
    }

    private async Task SaveProduct()
    {
        if (TenantState.CurrentCompanyId is not int companyId)
        {
            return;
        }

        await Commerce.SaveProductAsync(companyId, _editingProduct);
        await LoadData(resetForm: true);
    }

    private async Task DeleteProduct(int id)
    {
        if (TenantState.CurrentCompanyId is not int companyId)
        {
            return;
        }

        await Commerce.DeleteProductAsync(companyId, id);
        await LoadData(resetForm: true);
    }

    private async void HandleTenantChanged(Company _)
    {
        await InvokeAsync(async () =>
        {
            await LoadData(resetForm: true);
            StateHasChanged();
        });
    }
}

