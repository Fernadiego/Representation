@inject BlazorVentas.Services.AuthService AuthService
@inject BlazorVentas.Services.SessionService SessionService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IDisposable

@if (_isAuthorized)
{
    @ChildContent
}
else
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 100vh;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Verificando...</span>
        </div>
    </div>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private bool _isAuthorized = false;
    private System.Threading.Timer? _activityTimer;

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthorization();
        
        // Configurar timer para actualizar actividad cada minuto
        _activityTimer = new System.Threading.Timer(_ => 
        {
            _ = Task.Run(async () => await UpdateActivity());
        }, null, TimeSpan.FromMinutes(1), TimeSpan.FromMinutes(1));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CheckAuthorization();
        }
    }

    private async Task CheckAuthorization()
    {
        try
        {
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
            
            if (string.IsNullOrEmpty(token))
            {
                _isAuthorized = false;
                Navigation.NavigateTo("/login");
                return;
            }

            var isValid = await AuthService.ValidateTokenAsync(token);
            
            if (!isValid)
            {
                await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "authToken");
                _isAuthorized = false;
                Navigation.NavigateTo("/login");
                return;
            }

            _isAuthorized = true;
            StateHasChanged();
        }
        catch
        {
            _isAuthorized = false;
            Navigation.NavigateTo("/login");
        }
    }

    private async Task UpdateActivity()
    {
        try
        {
            var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");
            if (!string.IsNullOrEmpty(token))
            {
                await SessionService.UpdateActivityAsync(token);
            }
        }
        catch
        {
            // Ignorar errores
        }
    }

    public void Dispose()
    {
        _activityTimer?.Dispose();
    }
}

